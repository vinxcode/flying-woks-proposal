---
interface Props {
	title: string;
	body: string;
	href: string;
}

const { href, title, body } = Astro.props;
---

<article
	class="flex flex-col p-5 rounded-xl text-white bg-opacity-70 backdrop-filter
	backdrop-blur-lg w-11/12 max-w-[400px] xl:w-1/3 items-center gap-2 shadow-lg"
>
	<div class="">
		<img src={href} class="max-w-3/4 xl:max-w-[200px] mt-[-60px]" />
	</div>
	<div class="flex flex-col gap-1">
		<h3 class="text-xl font-semibold text-start">{title}</h3>
		<p class="text-start text-sm">{body}</p>
	</div>
	<button
		class="bg-red-500 py-3 rounded-lg font-semibold w-1/2 backdrop-filter backdrop-blur-lg
		hover:bg-red-400 text-sm mb-[-40px]"
		>Order now</button
	>
</article>
